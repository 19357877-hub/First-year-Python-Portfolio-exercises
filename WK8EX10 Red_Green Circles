def change():
  global colour
  if colour == 'red':
    colour = 'green'
  else:
    colour = 'red'
  near_id = canvas.find_closest(50,65)
  canvas.itemconfigure(near_id,fill=colour)

if __name__ == "__main__":
  root = Tk()
  button = Button(root,text = 'change', command = change)
  button.grid(row = 0,columnspan = 3,
            sticky = 'EW')
  canvas = Canvas(root,width=100,height = 100)
  canvas.create_oval(0,00,
                  100,100,
                  fill = 'red')
  colour = 'red'
  canvas.grid(row = 2, columnspan = 3,
            sticky='NSEW')
  root.resizable(width=False, height=False)
  root.mainloop()
